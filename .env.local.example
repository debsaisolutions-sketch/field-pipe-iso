# Supabase (anon key only — never put a service-role key in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated origins allowed to postMessage session into the iframe
# Defaults already include pipesketchpro.com and localhost:3001
NEXT_PUBLIC_ALLOWED_PARENT_ORIGINS=https://pipesketchpro.com,https://www.pipesketchpro.com,http://localhost:3001
